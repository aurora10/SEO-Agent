# In-container cron schedule for the seo-agent pipeline.
# Format:  min hour dom mon dow  user  command
# Each job is wrapped in run_job.py so every run is logged to data/jobs.log and
# a failure emails you (with the log tail) via the notify config in .env.

# --- Agent 1: GSC collector (daily, ~06:05 local) ---
5 6  * * *  root  cd /app && python src/run_job.py collect_gsc python src/collect_gsc.py --config /app/config.yaml

# --- Agent 2: market analysis (weekly, Monday ~06:30) ---
30 6  * * 1  root  cd /app && python src/run_job.py fetch_market python src/fetch_market.py --config /app/config.yaml
45 6  * * 1  root  cd /app && python src/run_job.py analyze_market python src/analyze_market.py --config /app/config.yaml

# --- Agent 3: content writer (weekly, Monday ~07:00; needs the constructief repo at /app/repo) ---
0 7   * * 1  root  cd /app && python src/run_job.py generate_content python src/generate_content.py --config /app/config.yaml --repo /app/repo

# --- Index monitor (weekly, Monday ~07:15) ---
15 7  * * 1  root  cd /app && python src/run_job.py gsc_monitor python src/gsc_monitor.py --config /app/config.yaml --repo /app/repo
