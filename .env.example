# Copy to .env on the VPS and fill in. This file is INSIDE the container as env vars.
# The container reconstructs config.yaml + credentials/ from these at startup.
# Never commit this file (already gitignored via .env/.env.example in .gitignore — add
# ".env" if it isn't there).

# --- Google Search Console ---
GSC_PROPERTY="https://constructief-bouw.be/"

# --- DataForSEO (Agent 2) ---
DFS_LOGIN=""
DFS_PASSWORD=""

# --- OpenAI (Agent 3) ---
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# --- Gmail notify (Agent 3 review emails) ---
NOTIFY_TO="aurora10@gmail.com"
NOTIFY_FROM="aurora10@gmail.com"
GMAIL_USER="aurora10@gmail.com"
GMAIL_APP_PASSWORD=""
SUBJECT_PREFIX="[SEO drafts]"

# --- GitHub publish (open a PR with drafts) ---
GITHUB_TOKEN=""
GITHUB_REPO="aurora10/constructief"
GITHUB_BASE_BRANCH="google-sheets"

# --- GSC OAuth credentials (base64 of credentials/*) ---
# Generate with:  base64 -i credentials/client_secret.json | tr -d '\n'   (and token.json)
CLIENT_SECRET_JSON=""
TOKEN_JSON=""

# --- Tunables (optional; defaults shown) ---
YOUR_DOMAIN="constructief-bouw.be"
BACKFILL_DAYS="90"
DB_PATH="data/seo.db"
MARKET_DB="data/market.db"
MARKET_ANALYSIS="data/market-analysis.json"
ROW_LIMIT="25000"

# --- Constructief site checkout (auto-cloned by the container; optional overrides) ---
# The container clones this repo (google-sheets = the deployed branch) into /app/repo
# at startup so Agent 3 + the index monitor read the live site's messages/data.
CONSTRUCTIEF_URL="https://github.com/aurora10/constructief.git"
CONSTRUCTIEF_BRANCH="google-sheets"
REPO_PATH="/app/repo"
